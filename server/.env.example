MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=a_long_random_secret
# Optional, default 7d
JWT_EXPIRES_IN=7d
# Image generation: Cloudflare Workers AI (free plan) is used when both are set
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_workers_ai_api_token
# Fallback provider, used only when the Cloudflare values are empty
CLIPDROP_API=your_clipdrop_api_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Frontend origin(s) allowed by CORS, comma separated. Leave empty in local development.
CLIENT_URL=https://imagify-project-phi.vercel.app
PORT=4000
